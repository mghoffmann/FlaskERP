# .env.example — template for the real .env file (gitignored; never commit
# actual secrets). Documents every variable from the Configuration table in
# requirements/00-architecture.md. For dev: `cp .env.example .env` and the
# defaults below work as-is with `docker compose up`.

# Flask app entry point, used by `flask run` / `flask db upgrade` / `flask
# seed` to find create_app(). Needed because the app uses an app-factory
# pattern (app/__init__.py:create_app()) rather than a plain module-level app.
FLASK_APP=app

# Selects which Config class create_app() loads (see app/config.py). Use
# "development" here; the deployed droplet's .env sets this to "production",
# which enforces a real SECRET_KEY and secure cookies.
FLASK_CONFIG=development

# SQLAlchemy connection string, dialect "postgresql+psycopg" (psycopg 3).
# This value assumes the app is running INSIDE docker-compose, where the `db`
# service is reachable at hostname `db` (Compose's built-in service DNS) on
# port 5432. Running Flask directly on the host instead (host Python against
# the dev container's published port) needs `db` replaced with `localhost`.
DATABASE_URL=postgresql+psycopg://erp:erp@db:5432/erp

# Signs session cookies. A throwaway value is fine in dev (the dev Config
# class is allowed to fall back to a default per 00-architecture.md), but set
# a real random one here anyway so dev behaves like prod. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

# Password assigned to the seeded "admin" user by `flask seed`. Defaults to
# admin123 in dev per 00-architecture.md if unset; set explicitly here so dev
# and prod follow the same code path.
SEED_ADMIN_PASSWORD=admin123

# Password assigned to the seeded "operator" user by `flask seed`.
SEED_OPERATOR_PASSWORD=operator123

# Public hostname used by Caddy to request a Let's Encrypt certificate in
# prod (docker-compose.prod.yml, a later phase). Unused in dev — left blank
# here as a placeholder so the variable is documented up front.
DOMAIN=
